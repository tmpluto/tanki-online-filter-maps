{
  "manifest_version": 3,
  "name": "Tanki Online - Filter Maps",
  "version": "2.0.0",
  "description": "Choose maps to hide in the Tanki Online battle list. Selected maps are dimmed and shrunk.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://tankionline.com/play/*", "https://*.tankionline.com/*"],
      "js": ["data.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}